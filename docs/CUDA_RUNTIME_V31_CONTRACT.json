{
  "schema": "gluball-cuda-runtime-v31-contract/1",
  "contract": "GLUBALL-CUDA-RUNTIME-V3.1",
  "status": "post-v1-pre-rental-runtime-research",
  "geometry_contract": "GLUBALL-KNOT-V1",
  "v2_reference_contract": "GLUBALL-CUDA-RUNTIME-V2",
  "v2_reference_source_blob_sha": "12d49ec6f78a28ed8d6afb5e8c7df80961c8bfc1",
  "v3_reference_contract": "GLUBALL-CUDA-RUNTIME-V3",
  "v3_reference_source_blob_sha": "dc8e9b209abee3794e5e56d0b92fa6d40dd03fd0",
  "executable": "gluball-cuda-runtime-v31",
  "purpose": "pre-rental efficiency refinement while preserving exact compact observation equivalence",
  "compatibility": {
    "v1_evidence_path_unchanged": true,
    "v2_source_unchanged": true,
    "v3_source_unchanged": true,
    "may_replace_v1_acceptance_evidence": false,
    "may_promote_performance_observation_to_geometry_authority": false
  },
  "optimization_invariants": {
    "packed_compact_metrics": {
      "enabled": true,
      "logical_bytes": 20,
      "resident_bytes": 24,
      "alignment_bytes": 8,
      "reset_operations_per_iteration_per_device": 1,
      "readback_operations_per_iteration_per_device": 1,
      "fields": ["digest_u64", "max_radius_bits_u32", "reserved_u32", "nonfinite_u64"]
    },
    "radius_weighted_v_angles": {
      "enabled": true,
      "immutable_after_setup": true,
      "stored_values": ["cos(angle)*tube_radius", "sin(angle)*tube_radius"],
      "hot_point_float_multiplications_removed": 2
    },
    "canonical_23_frame_trig_factoring": {
      "enabled": true,
      "canonical_ordered_signature": [2, 3],
      "trig_evaluations_per_u_setup": 4,
      "v3_reference_trig_evaluations_per_u_setup": 16,
      "swapped_embedding_enabled": false
    },
    "reduction_topologies": {
      "declared": ["atomic", "two-stage"],
      "atomic": "one digest XOR and one radius max global atomic per evaluation block; nonfinite add only when nonzero",
      "two-stage": "one 24-byte summary per evaluation block followed by one compact integer reduction kernel per selected device",
      "two_stage_global_metric_atomics": 0,
      "two_stage_associative_receivers": ["xor_u64", "max_u32", "sum_u64"],
      "kernel_timing_includes_second_stage": true
    }
  },
  "cache_boundary": {
    "principle": "resource optimization must not silently redefine the evaluated scientific object",
    "allowed": [
      "O(U) immutable frame lookup",
      "O(V) immutable weighted-angle lookup",
      "O(blocks) compact reduction summaries"
    ],
    "forbidden_for_throughput_claim": [
      "O(U*V) complete point cache",
      "cached radius-error field",
      "cached final digest",
      "cached complete observation"
    ],
    "full_point_cache_enabled": false,
    "cached_final_digest_enabled": false,
    "cached_complete_observation_enabled": false
  },
  "comparison_gate": {
    "script": "scripts/compare_cuda_runtime_v2_v3_v31.sh",
    "minimum_measured_iterations": 2,
    "selected_devices_must_be_homogeneous": true,
    "must_match_exactly": [
      "total_points_per_iteration",
      "used_device_count",
      "aggregate_diagnostic_xor64",
      "observed_max_tube_radius_error",
      "observed_nonfinite_records_max",
      "resolved_compiled_architectures"
    ],
    "break_even_metric": "ceil((v31_setup-v3_setup)/(v3_wall-v31_wall)) when observed per-iteration gain is positive",
    "break_even_is_observed_timing_metric": true,
    "equivalence_is_conformance_acceptance": false,
    "equivalence_is_geometry_receipt": false
  },
  "bounded_tuning": {
    "script": "scripts/tune_cuda_runtime_v31.sh",
    "search_class": "bounded-exhaustive-combinatorial-performance-observation",
    "default_block_sizes": [32, 64, 128, 256, 512, 1024],
    "default_cuda_graph_modes": ["off", "on"],
    "default_reduction_modes": ["atomic", "two-stage"],
    "default_trials_per_candidate": 3,
    "default_candidate_count": 24,
    "minimum_measured_iterations": 2,
    "candidate_enumeration_deterministic": true,
    "best_observed_candidate_within_declared_set_only": true,
    "rigorous_global_optimum_claim": false,
    "unbounded_configuration_space_global_optimum_claim": false
  },
  "deferred_until_after_weak_gpu_measurement": [
    "u32 index specialization",
    "block-shared angle staging",
    "manual v-loop unrolling",
    "other memory-layout changes"
  ],
  "observation_semantics": {
    "performance_observation_only": true,
    "reference_residual_checked": false,
    "conformance_acceptance": false,
    "complete_output_readback": false,
    "geometry_receipt_authority": false,
    "universal_speedup_claim": false,
    "raw_device_uuid_published": false
  },
  "donor_patterns": {
    "RSH": ["compact fixed-size accelerator records", "hierarchical local-summary reduction"],
    "TAS": ["hoist configuration-invariant work out of deep evaluation loops"],
    "QSOL-GEO-REASON": ["cache/state reuse remains a measurement variable and must not redefine the object"],
    "BLOCH": ["explicit deterministic LUT policy and bounded representation discipline"]
  }
}
