{
  "schema": "gluball-agent-contract/1",
  "project": {
    "name": "GLUBALL",
    "repository": "QSOLKCB/GLUBALL",
    "canonical_geometry_contract": "GLUBALL-KNOT-V1",
    "status": "bootstrap-and-optimization",
    "license": "MPL-2.0"
  },
  "authority_order": [
    "docs/AI_AGENT_CONTRACT.json",
    "docs/GLUBALL_KNOT.md",
    "docs/PROVENANCE_BOUNDARY.md",
    "ROADMAP.md",
    "gluball-core.js",
    "tests"
  ],
  "canonical_geometry": {
    "family": "thickened-(2,3)-torus-knot",
    "parameters": {
      "p": 2,
      "q": 3,
      "R": 2.1,
      "r": 0.85,
      "rho": 0.34,
      "mesh_u": 96,
      "mesh_v": 18
    },
    "centreline": "C(t)=((R+r*cos(q*t))*cos(p*t),(R+r*cos(q*t))*sin(p*t),r*sin(q*t))",
    "surface": "G(t,v)=C(t)+rho*(N(t)*cos(v)+B(t)*sin(v))",
    "frame_policy": "host-torus-normal-plus-orthogonal-binormal",
    "required_invariants": [
      "centreline_2pi_periodicity",
      "centreline_regularity",
      "threefold_rotational_symmetry",
      "host_torus_normal_unit_norm",
      "tangent_normal_orthogonality",
      "frame_orthogonality",
      "surface_periodicity_u",
      "surface_periodicity_v",
      "tube_radius_invariance",
      "integer_tick_determinism"
    ]
  },
  "provenance_boundary": {
    "retired_geometry_status": "forbidden-in-canonical-implementation",
    "historical_sources": [
      "deleted VORTEX repository archives",
      "deleted VORTEX2 repository archives",
      "historical NEXUS archives",
      "deleted DOI record material"
    ],
    "historical_source_policy": "reference-only",
    "allowed_uses": [
      "engineering-technique inventory",
      "provenance documentation",
      "regression boundary identification",
      "non-authoritative historical analysis"
    ],
    "forbidden_uses": [
      "copy retired centre-transfer geometry into canonical GLUBALL code",
      "restore gate-centre-mouth geometry",
      "restore D1-D2 geometry as a GLUBALL primitive",
      "derive GLUBALL topology from retired mouth-anus terminology"
    ],
    "retired_terms_policy": {
      "canonical_geometry": "forbidden",
      "canonical_state_or_equations": "forbidden",
      "provenance_docs": "allowed",
      "non_authoritative_ui_satire": "allowed"
    }
  },
  "phase_2": {
    "goal": "adapt useful deterministic and evidence engineering without restoring retired geometry",
    "planned_contracts": [
      "GLUBALL-SAMPLING-V1",
      "GLUBALL-EVIDENCE-V1"
    ],
    "sampling_requirements": [
      "exact integer logical-to-rendered index mapping",
      "bounded allocation",
      "deterministic ordered coverage",
      "reject overlap gaps overflow and order drift",
      "seal golden index vectors"
    ],
    "evidence_requirements": [
      "canonical serialization before hashing",
      "domain-separated SHA-256 receipts",
      "bind geometry contract",
      "bind sampling contract",
      "bind parameter set",
      "bind logical and rendered counts",
      "bind animation tick when applicable",
      "bind implementation and runtime identity",
      "receipts are identity evidence not physical truth"
    ],
    "optional_layers": {
      "ternary_triality": "metadata-execution-sonification-only",
      "fibonacci_phi_sampling": "separate-explicit-sampling-policy",
      "sonification": "deterministic-event-stream",
      "capture": "reproducible-json-png-webm",
      "accelerators": "residual-sidecar-only"
    }
  },
  "rsh_handoff": {
    "target_repository": "QSOLKCB/RSH",
    "integration_mode": "additive-geometry-family",
    "must_not_replace": "Robitaille-Slade helix",
    "existing_formal_surface": "RSH-FORMAL-V1",
    "new_formal_surface": "RSH-GLUBALL-FORMAL-V1",
    "entry_gates": [
      "GLUBALL-KNOT-V1 frozen in tagged release",
      "GLUBALL-SAMPLING-V1 frozen with sealed vectors",
      "GLUBALL-EVIDENCE-V1 frozen with canonical receipt vectors",
      "reference geometry tests green",
      "deterministic sampling tests green",
      "declared CPU-WASM conformance green if included in release",
      "provenance semantic quarantine green",
      "historical archives remain reference-only",
      "ternary-triality remains explicitly non-topological",
      "no new physical empirical biological or consciousness claims"
    ],
    "software_rules": [
      "preserve existing RSH geometry contract unless explicitly version-bumped for an independent reason",
      "import stable GLUBALL mathematical contract and sealed vectors rather than browser renderer authority",
      "record exact GLUBALL release and source commit",
      "keep presentation state outside theorem-facing core",
      "update RSH release metadata only after runtime and proof checks pass"
    ],
    "proposed_lean_modules": [
      "formal/lean/RSH/Gluball/Parameters.lean",
      "formal/lean/RSH/Gluball/Centerline.lean",
      "formal/lean/RSH/Gluball/Frame.lean",
      "formal/lean/RSH/Gluball/Surface.lean",
      "formal/lean/RSH/Gluball/Symmetry.lean",
      "formal/lean/RSH/Gluball/Sampling.lean",
      "formal/lean/RSH/Gluball/Main.lean"
    ],
    "initial_theorem_targets": [
      "canonical_parameter_domain_validity",
      "centreline_2pi_periodicity",
      "centreline_regularity",
      "threefold_rotational_symmetry",
      "host_torus_normal_unit_norm",
      "tangent_normal_orthogonality",
      "binormal_normalization",
      "frame_orthogonality",
      "surface_periodicity_u",
      "surface_periodicity_v",
      "tube_radius_invariance",
      "deterministic_mesh_index_wrap",
      "exact_logical_to_rendered_index_properties"
    ],
    "rsh_audit_requirements": [
      "import new GLUBALL theorem surface without weakening RSH-FORMAL-V1",
      "print axiom dependencies for every advertised GLUBALL release theorem",
      "reject sorry",
      "reject admit",
      "reject project-defined axiom declarations",
      "reject project-defined constant declarations",
      "pin new proof dependencies before release"
    ],
    "deferred_targets": [
      "global_tube_embeddedness_non_self_intersection",
      "ieee754_runtime_equivalence",
      "renderer_camera_visibility_or_occlusion",
      "physical_interpretation",
      "receipt_implies_empirical_truth"
    ],
    "embeddedness_policy": "requires a separate theorem with explicit thickness-reach or minimum-distance hypotheses"
  },
  "agent_behavior": {
    "on_contract_conflict": "stop-and-request-human-review",
    "on_unknown_provenance": "fail-closed",
    "on_geometry_contract_change": "update docs machine contract tests and version metadata together",
    "on_rsh_handoff_before_entry_gates": "refuse-implementation-and-report-unsatisfied-gates",
    "on_renderer_change": "do-not-change-canonical-geometry-implicitly",
    "on_accelerator_result": "report-residual-only"
  },
  "validation": {
    "commands": [
      "node tests/smoke.mjs",
      "node tests/agent-contract.mjs"
    ]
  }
}
